build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\works\C\ra6m4\build\Debug && C:\renesas_toolchain\cmake\3.31.8\cmake-3.31.8-windows-x86_64\bin\cmake.exe --regenerate-during-build -SC:\works\C\ra6m4 -BC:\works\C\ra6m4\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
