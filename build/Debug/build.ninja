  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\works\C\ra6m4\build\Debug && C:\renesas_toolchain\cmake\3.31.8\cmake-3.31.8-windows-x86_64\bin\cmake-gui.exe -SC:\works\C\ra6m4 -BC:\works\C\ra6m4\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
